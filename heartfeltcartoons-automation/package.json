{
  "name": "heartfeltcartoons-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Technical assistant tooling for the @heartfeltcartoons Instagram account: comment engine (human-in-the-loop), content preparation and prompt library.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "webhook": "tsx src/index.ts webhook",
    "comments": "tsx src/index.ts comments",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
