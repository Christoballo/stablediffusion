# Instagram / Meta (official Graph API only – never hardcode tokens in code)
IG_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WEBHOOK_VERIFY_TOKEN=

# Working mode (default: human-in-the-loop, auto reply OFF)
AUTO_REPLY_ENABLED=false
AUTO_LIKE_ENABLED=true
MAX_AUTO_REPLIES_PER_HOUR=25
MAX_AUTO_LIKES_PER_HOUR=100

# Video generation via Higgsfield MCP (only on explicit user request)
HIGGSFIELD_MCP_ENABLED=true

# Infrastructure
GRAPH_API_BASE=https://graph.facebook.com/v21.0
WEBHOOK_PORT=3000
DB_PATH=./data/heartfeltcartoons.db
