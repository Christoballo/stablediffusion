# ============================================================================
# WM Content Hub — environment configuration
# Copy this file to `.env` and fill in the real values. Never commit `.env`.
# ============================================================================

# --- Instagram Graph API (required for real publishing) --------------------
# How to obtain these:
#   1. Convert the Instagram account to a Professional (Business/Creator) account.
#   2. Connect it to a Facebook Page.
#   3. Create a Meta app at https://developers.facebook.com, add the
#      "Instagram Graph API" product, and generate a long-lived User token with
#      scopes: instagram_basic, instagram_content_publish, instagram_manage_insights,
#      pages_show_list, pages_read_engagement, business_management.
#   4. Resolve the IG user id via:  GET /me/accounts -> page -> instagram_business_account
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# --- Facebook (optional cross-post) ----------------------------------------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
ENABLE_FACEBOOK=false

# --- Higgsfield content generation (image/video) ---------------------------
# Get an API key from your Higgsfield account. Generated assets are returned as
# public CDN URLs, which are fed straight to the Instagram Graph API.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://platform.higgsfield.ai/v1

# --- Caption LLM (optional but recommended) --------------------------------
# If set, captions/hooks are written by Claude. If empty, the deterministic
# template engine is used as a fallback (still fully functional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Behaviour --------------------------------------------------------------
# DRY_RUN=true generates + plans + writes everything to the store but does NOT
# call the Instagram publish endpoint. Flip to false to go live.
DRY_RUN=true
TIMEZONE=Europe/Berlin
# How many pieces of content to ship per day (the optimal mix is computed for you).
POSTS_PER_DAY=3
# Brand handle used in captions / CTAs.
BRAND_HANDLE=@wm.zone
BRAND_NAME=WM Zone
# Primary content language (de | en).
CONTENT_LANGUAGE=de
# Follower count (used in the media kit / rate card). Update as you grow.
BRAND_FOLLOWERS=

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
